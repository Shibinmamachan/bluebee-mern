PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bluebee
CLIENT_URL=http://localhost:5173

# --- Admin login ---
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=shibinm305@gmail.com
# Recommended: run `npm run hash` and paste the result here (keep the quotes), then delete ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me

# --- Uploads (photos & videos added from the admin panel) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
# Public URL of this API, only needed if the website is hosted on a different domain than the API
# (e.g. https://api.bluebee.in). Leave empty when using the Vite proxy or one domain.
PUBLIC_API_URL=

# --- Email (optional: without it, bookings still work but no emails are sent) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shibinm305@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Blue Bee Events <shibinm305@gmail.com>"

# Set to 1 when running behind a proxy/host such as Render, Railway or Nginx
TRUST_PROXY=0

# --- AI chat assistant ---
# Create a free-tier key at https://aistudio.google.com/apikey . Keep it private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CHAT_DAILY_LIMIT=1500
# Used for greetings ("Good evening") and the team online/offline message
BUSINESS_TZ=Asia/Kolkata
BUSINESS_HOURS=09:00-19:00
COMPANY_NAME="Blue Bee Events"
COMPANY_PHONE="+91 85920 19430"
COMPANY_EMAIL=shibinm305@gmail.com
COMPANY_ADDRESS="Your street, Your city, Kerala"
WHATSAPP_NUMBER=918592019430
